<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>GAAWOW EMS — Teacher Portal</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --navy:#0B1E63;
      --blue:#0B4DA2;
      --gold:#D4AF37;
      --green:#198754;
      --red:#dc3545;
      --gray:#F5F7FA;
      --white:#fff;
      --text:#172033;
      --muted:#6b7280;
      --border:#e5e7eb;
      --shadow:0 8px 25px rgba(11,30,99,.08);
    }

    *{
      box-sizing:border-box;
    }

    body{
      margin:0;
      font-family:Arial,Helvetica,sans-serif;
      background:var(--gray);
      color:var(--text);
    }

    button,
    a,
    input{
      font-family:inherit;
    }

    .topbar{
      background:linear-gradient(135deg,var(--navy),var(--blue));
      color:#fff;
      padding:16px 22px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:15px;
      position:sticky;
      top:0;
      z-index:100;
      box-shadow:0 4px 18px rgba(0,0,0,.12);
    }

    .brand{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .logo{
      width:46px;
      height:46px;
      border-radius:12px;
      object-fit:contain;
      background:#fff;
      padding:4px;
    }

    .brand-title{
      font-size:19px;
      font-weight:800;
    }

    .brand-subtitle{
      font-size:11px;
      opacity:.85;
      margin-top:3px;
    }

    .top-actions{
      display:flex;
      align-items:center;
      gap:8px;
    }

    .profile-mini{
      display:flex;
      align-items:center;
      gap:8px;
      padding:7px 10px;
      background:rgba(255,255,255,.12);
      border:1px solid rgba(255,255,255,.2);
      border-radius:10px;
    }

    .profile-mini img{
      width:34px;
      height:34px;
      border-radius:50%;
      object-fit:cover;
      border:2px solid var(--gold);
      background:#fff;
    }

    .profile-mini strong{
      font-size:12px;
      display:block;
    }

    .profile-mini span{
      font-size:10px;
      opacity:.8;
    }

    .logout-btn{
      border:0;
      background:#fff;
      color:var(--navy);
      padding:9px 13px;
      border-radius:9px;
      font-weight:800;
      cursor:pointer;
    }

    .layout{
      display:flex;
      min-height:calc(100vh - 78px);
    }

    .sidebar{
      width:245px;
      background:#fff;
      border-right:1px solid var(--border);
      padding:18px 12px;
      flex-shrink:0;
    }

    .side-title{
      padding:8px 12px 12px;
      color:var(--muted);
      font-size:11px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.5px;
    }

    .side-btn{
      width:100%;
      border:0;
      background:transparent;
      color:var(--text);
      padding:12px;
      border-radius:10px;
      text-align:left;
      cursor:pointer;
      font-weight:700;
      font-size:13px;
      margin-bottom:4px;
      display:flex;
      align-items:center;
      gap:10px;
    }

    .side-btn:hover,
    .side-btn.active{
      background:#edf3ff;
      color:var(--navy);
    }

    .side-icon{
      width:27px;
      height:27px;
      display:flex;
      align-items:center;
      justify-content:center;
      border-radius:7px;
      background:#f1f4f9;
      font-size:15px;
    }

    .main{
      flex:1;
      min-width:0;
      padding:24px;
    }

    .welcome{
      background:linear-gradient(135deg,var(--navy),var(--blue));
      color:#fff;
      border-radius:18px;
      padding:24px;
      margin-bottom:20px;
      box-shadow:var(--shadow);
      position:relative;
      overflow:hidden;
    }

    .welcome:after{
      content:"";
      position:absolute;
      width:220px;
      height:220px;
      border-radius:50%;
      background:rgba(255,255,255,.06);
      right:-80px;
      top:-90px;
    }

    .welcome h1{
      margin:0 0 7px;
      font-size:25px;
    }

    .welcome p{
      margin:0;
      font-size:13px;
      opacity:.88;
    }

    .role-badge{
      display:inline-block;
      margin-top:14px;
      background:var(--gold);
      color:#111;
      padding:6px 10px;
      border-radius:999px;
      font-size:11px;
      font-weight:800;
    }

    .stats{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:15px;
      margin-bottom:20px;
    }

    .stat{
      background:#fff;
      border:1px solid var(--border);
      border-radius:15px;
      padding:18px;
      box-shadow:var(--shadow);
    }

    .stat-icon{
      font-size:23px;
      margin-bottom:10px;
    }

    .stat-label{
      color:var(--muted);
      font-size:12px;
      font-weight:700;
    }

    .stat-value{
      font-size:27px;
      font-weight:900;
      margin-top:5px;
      color:var(--navy);
    }

    .content-grid{
      display:grid;
      grid-template-columns:2fr 1fr;
      gap:18px;
    }

    .card{
      background:#fff;
      border:1px solid var(--border);
      border-radius:15px;
      box-shadow:var(--shadow);
      overflow:hidden;
    }

    .card-head{
      padding:16px 18px;
      border-bottom:1px solid var(--border);
      display:flex;
      align-items:center;
      justify-content:space-between;
    }

    .card-head h2{
      margin:0;
      font-size:16px;
    }

    .card-body{
      padding:18px;
    }

    .quick-grid{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:12px;
    }

    .quick-btn{
      border:1px solid var(--border);
      background:#fff;
      border-radius:12px;
      padding:16px;
      cursor:pointer;
      text-align:left;
      transition:.2s;
    }

    .quick-btn:hover{
      border-color:#b9c8ea;
      transform:translateY(-1px);
      box-shadow:0 6px 18px rgba(11,30,99,.07);
    }

    .quick-btn .qicon{
      font-size:23px;
      margin-bottom:9px;
    }

    .quick-btn strong{
      display:block;
      font-size:13px;
      margin-bottom:4px;
    }

    .quick-btn span{
      color:var(--muted);
      font-size:11px;
    }

    .profile-card{
      text-align:center;
    }

    .profile-avatar{
      width:105px;
      height:105px;
      border-radius:50%;
      object-fit:cover;
      border:4px solid var(--gold);
      background:#eef1f6;
      margin-bottom:10px;
    }

    .profile-card h3{
      margin:3px 0;
      font-size:18px;
    }

    .profile-role{
      color:var(--muted);
      font-size:12px;
      margin-bottom:16px;
    }

    .profile-detail{
      display:flex;
      justify-content:space-between;
      gap:10px;
      border-bottom:1px solid var(--border);
      padding:10px 0;
      font-size:12px;
      text-align:left;
    }

    .profile-detail span{
      color:var(--muted);
    }

    .profile-detail strong{
      text-align:right;
      max-width:60%;
      word-break:break-word;
    }

    .notice{
      background:#f8fafc;
      border:1px dashed #cbd5e1;
      border-radius:12px;
      padding:15px;
      color:var(--muted);
      font-size:12px;
      line-height:1.6;
    }

    .loading-screen{
      position:fixed;
      inset:0;
      background:var(--gray);
      display:flex;
      align-items:center;
      justify-content:center;
      z-index:9999;
    }

    .loading-box{
      background:#fff;
      padding:30px;
      border-radius:16px;
      text-align:center;
      box-shadow:var(--shadow);
      width:min(350px,90%);
    }

    .spinner{
      width:40px;
      height:40px;
      border:4px solid #e5e7eb;
      border-top-color:var(--navy);
      border-radius:50%;
      animation:spin .8s linear infinite;
      margin:0 auto 15px;
    }

    @keyframes spin{
      to{transform:rotate(360deg)}
    }

    .error-box{
      display:none;
      background:#fee2e2;
      color:#991b1b;
      border:1px solid #fecaca;
      padding:14px;
      border-radius:10px;
      margin-bottom:15px;
      font-size:13px;
    }

    @media(max-width:1000px){
      .stats{
        grid-template-columns:repeat(2,1fr);
      }

      .content-grid{
        grid-template-columns:1fr;
      }
    }

    @media(max-width:760px){
      .topbar{
        padding:11px 12px;
      }

      .brand-title{
        font-size:15px;
      }

      .brand-subtitle{
        font-size:9px;
      }

      .logo{
        width:38px;
        height:38px;
      }

      .profile-mini div{
        display:none;
      }

      .sidebar{
        width:70px;
        padding:12px 7px;
      }

      .side-title{
        display:none;
      }

      .side-btn{
        justify-content:center;
        padding:11px 5px;
      }

      .side-btn span:not(.side-icon){
        display:none;
      }

      .side-icon{
        width:38px;
        height:38px;
      }

      .main{
        padding:12px;
      }

      .welcome{
        padding:19px;
      }

      .welcome h1{
        font-size:20px;
      }

      .stats{
        gap:9px;
      }

      .stat{
        padding:13px;
      }

      .stat-value{
        font-size:22px;
      }

      .quick-grid{
        grid-template-columns:1fr 1fr;
      }

      .logout-btn{
        padding:8px 9px;
        font-size:11px;
      }
    }

    @media(max-width:420px){
      .quick-grid{
        grid-template-columns:1fr;
      }
    }
  </style>
</head>

<body>

  <div id="loadingScreen" class="loading-screen">
    <div class="loading-box">
      <div class="spinner"></div>
      <strong>GAAWOW EMS</strong>
      <p id="loadingText">Checking teacher access...</p>
    </div>
  </div>

  <header class="topbar">

    <div class="brand">
      <img
        class="logo"
        src="./gaawow-logo.png"
        alt="GAAWOW Academy"
        onerror="this.style.display='none'"
      >

      <div>
        <div class="brand-title">GAAWOW EMS</div>
        <div class="brand-subtitle">Teacher Portal</div>
      </div>
    </div>

    <div class="top-actions">

      <div class="profile-mini">
        <img id="topAvatar" src="" alt="Teacher">
        <div>
          <strong id="topName">Teacher</strong>
          <span>Teacher</span>
        </div>
      </div>

      <button class="logout-btn" id="logoutBtn">
        Logout
      </button>

    </div>
  </header>

  <div class="layout">

    <aside class="sidebar">

      <div class="side-title">Teacher Menu</div>

      <button class="side-btn active">
        <span class="side-icon">🏠</span>
        <span>Dashboard</span>
      </button>

      <button class="side-btn" onclick="comingSoon('My Classes')">
        <span class="side-icon">🏫</span>
        <span>My Classes</span>
      </button>

      <button class="side-btn" onclick="comingSoon('My Students')">
        <span class="side-icon">👨‍🎓</span>
        <span>My Students</span>
      </button>

      <button class="side-btn" onclick="comingSoon('My Subjects')">
        <span class="side-icon">📚</span>
        <span>My Subjects</span>
      </button>

      <button class="side-btn" onclick="comingSoon('Attendance')">
        <span class="side-icon">📅</span>
        <span>Attendance</span>
      </button>

      <button class="side-btn" onclick="comingSoon('Exams')">
        <span class="side-icon">📝</span>
        <span>Exams</span>
      </button>

      <button class="side-btn" onclick="comingSoon('Grades & Results')">
        <span class="side-icon">📊</span>
        <span>Grades & Results</span>
      </button>

      <button class="side-btn" onclick="showProfile()">
        <span class="side-icon">👤</span>
        <span>My Profile</span>
      </button>

    </aside>

    <main class="main">

      <div id="errorBox" class="error-box"></div>

      <section class="welcome">

        <h1>
          Welcome, <span id="welcomeName">Teacher</span> 👋
        </h1>

        <p>
          GAAWOW Academy Education Management & Verification System
        </p>

        <span class="role-badge">
          TEACHER PORTAL
        </span>

      </section>

      <section class="stats">

        <div class="stat">
          <div class="stat-icon">👨‍🎓</div>
          <div class="stat-label">My Students</div>
          <div class="stat-value" id="studentsCount">0</div>
        </div>

        <div class="stat">
          <div class="stat-icon">📚</div>
          <div class="stat-label">My Subjects</div>
          <div class="stat-value" id="subjectsCount">0</div>
        </div>

        <div class="stat">
          <div class="stat-icon">🏫</div>
          <div class="stat-label">My Classes</div>
          <div class="stat-value" id="classesCount">0</div>
        </div>

        <div class="stat">
          <div class="stat-icon">📝</div>
          <div class="stat-label">My Exams</div>
          <div class="stat-value" id="examsCount">0</div>
        </div>

      </section>

      <section class="content-grid">

        <div>

          <div class="card">

            <div class="card-head">
              <h2>Quick Actions</h2>
            </div>

            <div class="card-body">

              <div class="quick-grid">

                <button class="quick-btn" onclick="comingSoon('My Students')">
                  <div class="qicon">👨‍🎓</div>
                  <strong>My Students</strong>
                  <span>View students assigned to you</span>
                </button>

                <button class="quick-btn" onclick="comingSoon('Attendance')">
                  <div class="qicon">📅</div>
                  <strong>Attendance</strong>
                  <span>Manage student attendance</span>
                </button>

                <button class="quick-btn" onclick="comingSoon('Exams')">
                  <div class="qicon">📝</div>
                  <strong>Exams</strong>
                  <span>Create and manage exams</span>
                </button>

                <button class="quick-btn" onclick="comingSoon('Grades & Results')">
                  <div class="qicon">📊</div>
                  <strong>Grades & Results</strong>
                  <span>Enter and manage student results</span>
                </button>

              </div>

            </div>

          </div>

          <div class="card" style="margin-top:18px;">

            <div class="card-head">
              <h2>Teacher Workspace</h2>
            </div>

            <div class="card-body">

              <div class="notice">

                <strong>Teacher Portal V1</strong><br><br>

                This portal is restricted to users whose
                <strong>profiles.role = teacher</strong>
                and whose account is active.

                <br><br>

                Student, class, subject, attendance, examination
                and result permissions will be connected to the
                corresponding database relationships in the next modules.

              </div>

            </div>

          </div>

        </div>

        <div>

          <div class="card profile-card">

            <div class="card-head">
              <h2>My Profile</h2>
            </div>

            <div class="card-body">

              <img
                id="profileAvatar"
                class="profile-avatar"
                src=""
                alt="Teacher photo"
              >

              <h3 id="profileName">
                Teacher
              </h3>

              <div class="profile-role">
                Teacher
              </div>

              <div class="profile-detail">
                <span>Email</span>
                <strong id="profileEmail">—</strong>
              </div>

              <div class="profile-detail">
                <span>Phone</span>
                <strong id="profilePhone">—</strong>
              </div>

              <div class="profile-detail">
                <span>Institution</span>
                <strong id="profileInstitution">—</strong>
              </div>

              <div class="profile-detail">
                <span>Status</span>
                <strong id="profileStatus">—</strong>
              </div>

            </div>

          </div>

        </div>

      </section>

    </main>

  </div>

<script src="./teacher-portal.js?v=20261009fix1"></script>
</body>
</html>
